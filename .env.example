# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./data/qr.db

# For stateless /render calls (no tenant context, no identity-service needed).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Only needed for the persisted, tenant-scoped /codes endpoints. Point this
# at your identity-service's /public-key, or paste the PEM directly into
# IDENTITY_PUBLIC_KEY_PEM if this service can't reach it over the network.
IDENTITY_PUBLIC_KEY_URL=http://identity-service:8000/public-key
IDENTITY_PUBLIC_KEY_PEM=
JWT_ISSUER=identity-service
